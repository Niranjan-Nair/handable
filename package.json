{
  "name": "handwrite",
  "version": "1.0.0",
  "description": "Learns your handwriting from a few samples and writes any text in it, as SVG or PDF.",
  "type": "module",
  "bin": {
    "handwrite": "./cli.js"
  },
  "scripts": {
    "start": "npx serve .",
    "test": "node --test test/*.test.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "check": "prettier --check . && eslint . && node --test test/*.test.js"
  },
  "engines": {
    "node": ">=18"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "prettier": "^3.0.0"
  }
}
